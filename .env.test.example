# Testes automatizados: pnpm test:integration, pnpm db:migrate:test e pnpm dev:test (backend para o E2E do front).
# Aponte SEMPRE para a branch Neon `teste`. Nunca `production` nem `desenvolvimento`.
NODE_ENV=test
PORT=3001
# Neon (branch teste): connection string com pooler
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=verify-full&channel_binding=require
# Neon (branch teste): conexão direta, sem pooler (migrações)
DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@HOST/DB?sslmode=verify-full&channel_binding=require
BETTER_AUTH_SECRET=troque-por-um-segredo-aleatorio-com-32-ou-mais-caracteres
BETTER_AUTH_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=warn
