{
  "name": "finance-control-back",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "test": "vitest run --dir src",
    "test:watch": "vitest --dir src",
    "test:integration": "vitest run --dir tests/integration",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --dir src --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --env-file-if-exists=.env src/db/seed/index.ts",
    "verify": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "dependencies": {
    "@hono/node-server": "2.1.6",
    "better-auth": "1.7.18",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.16",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@playwright/test": "1.65.0",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.1.0",
    "drizzle-kit": "0.31.11",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
