NODE_ENV=development
PORT=3001
# Neon: connection string com pooler (aplicação)
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=verify-full&channel_binding=require
# Neon: conexão direta, sem pooler (migrações)
DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@HOST/DB?sslmode=verify-full&channel_binding=require
BETTER_AUTH_SECRET=troque-por-um-segredo-aleatorio-com-32-ou-mais-caracteres
BETTER_AUTH_URL=http://localhost:3001
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CORS_ORIGINS=http://localhost:3000
# E-mail (recuperação de senha). Vazio em dev = o link aparece no log do backend.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=seu@gmail.com, SMTP_PASS=<senha de app>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
LOG_LEVEL=debug
